{
  "name": "@corvu-next/prevent-scroll",
  "version": "0.1.5",
  "description": "SolidJS 2 utility that prevents scrolling outside of a given DOM element.",
  "license": "MIT",
  "author": {
    "name": "Jasmin Noetzli (upstream), @corvu-next contributors (fork)",
    "email": "code@jasi.dev",
    "url": "https://github.com/GiyoMoon"
  },
  "homepage": "https://corvu.dev/docs/utilities/prevent-scroll",
  "bugs": {
    "url": "https://github.com/corvudev/corvu/issues",
    "email": "code@jasi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opencenter-cloud/corvu-next.git",
    "directory": "packages/solid-prevent-scroll"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
